# ==============================================================================
# meeting-transcriber-action-extractor Environment Configuration (Vecesta.co)
# ==============================================================================

# AI Provider: rule (offline rule engine) | gemini | ollama | openai
AI_PROVIDER=rule

# faster-whisper Model Size: tiny | base | small | medium | large-v3
WHISPER_MODEL=base

# Cloud API Keys (optional if using rule or ollama)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Ollama Endpoint
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

